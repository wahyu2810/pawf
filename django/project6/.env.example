# Salin file ini menjadi .env lalu isi kredensial email Anda.
# .env berisi rahasia dan TIDAK boleh di-commit ke Git.

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Email pengirim (akun Gmail Anda) dan App Password 16 karakter.
EMAIL_HOST_USER=email_anda@gmail.com
EMAIL_HOST_PASSWORD=xxxxxxxxxxxxxxxx

DEFAULT_FROM_EMAIL=Blog Wahyu <email_anda@gmail.com>
